# app/api/v1/projects.py
from fastapi import APIRouter, Depends, HTTPException, Query, Path
from typing import List, Optional
from pydantic import BaseModel, Field
from datetime import datetime
import uuid

from app.dependencies import get_current_user_with_supabase, get_tenant_id

router = APIRouter()

class ProjectBase(BaseModel):
    name: str
    description: Optional[str] = None
    status: str = "active"
    repo_url: Optional[str] = "https://github.com/example/repo"
    branch: Optional[str] = "main"
    language: Optional[str] = "TypeScript"

class ProjectCreate(ProjectBase):
    scan_types: Optional[List[str]] = Field(default_factory=lambda: ["SAST", "SCA", "SECRETS"])

class ProjectResponse(ProjectBase):
    id: str
    tenant_id: str
    created_at: datetime
    updated_at: datetime
    scan_count: int = 0
    finding_count: int = 0
    risk_score: int = 0
    trend: str = "stable"
    last_scan_at: Optional[datetime] = None

class ProjectUpdate(BaseModel):
    name: Optional[str] = None
    description: Optional[str] = None
    status: Optional[str] = None

